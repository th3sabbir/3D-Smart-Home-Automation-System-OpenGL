
#include <GL/freeglut.h>
#include <cmath>
#include <string>
#include <sstream>
#include <iomanip>

using namespace std;

// ==========================================
// WINDOW SETTINGS
// ==========================================

const int WIDTH = 1200;
const int HEIGHT = 750;

const float PI = 3.14159265f;

// ==========================================
// SMART HOME SYSTEM VARIABLES
// ==========================================

// Lighting
bool livingLight = false;
bool bedroomLight = false;
bool kitchenLight = false;

// Fans
bool livingFan = false;
bool bedroomFan = false;

float livingFanAngle = 0.0f;
float bedroomFanAngle = 0.0f;

int fanSpeed = 1;

// Door and Window
bool doorOpen = false;
bool windowOpen = false;

float doorAngle = 0.0f;
float windowOffset = 0.0f;

// Security
bool securityEnabled = false;
bool alarmActive = false;

// Temperature
float temperature = 28.0f;

// Energy monitoring
float energyConsumption = 0.0f;
float totalPower = 0.0f;

// Simulation time
int simulationSeconds = 0;

// ==========================================
// BASIC DRAWING FUNCTIONS
// ==========================================

void color(float r, float g, float b)
{
    glColor3f(r, g, b);
}

void rectangle(float x, float y, float w, float h,
               float r, float g, float b)
{
    color(r, g, b);

    glBegin(GL_QUADS);

    glVertex2f(x, y);
    glVertex2f(x + w, y);
    glVertex2f(x + w, y + h);
    glVertex2f(x, y + h);

    glEnd();
}

void circle(float x, float y, float radius,
            float r, float g, float b)
{
    color(r, g, b);

    glBegin(GL_TRIANGLE_FAN);

    glVertex2f(x, y);

    for (int i = 0; i <= 60; i++)
    {
        float angle = 2.0f * PI * i / 60.0f;

        glVertex2f(
            x + cos(angle) * radius,
            y + sin(angle) * radius
        );
    }

    glEnd();
}

void line(float x1, float y1, float x2, float y2,
          float r, float g, float b, float thickness = 2)
{
    color(r, g, b);

    glLineWidth(thickness);

    glBegin(GL_LINES);

    glVertex2f(x1, y1);
    glVertex2f(x2, y2);

    glEnd();
}

void text(float x, float y, string value,
          float r = 1, float g = 1, float b = 1)
{
    color(r, g, b);

    glRasterPos2f(x, y);

    for (char c : value)
    {
        glutBitmapCharacter(GLUT_BITMAP_HELVETICA_12, c);
    }
}

void centeredText(float x, float y, string value)
{
    float width = value.length() * 7.0f;

    text(x - width / 2, y, value);
}

// ==========================================
// ROOM DRAWING
// ==========================================

void drawRoom(float x, float y, float w, float h,
              string name, bool lightOn)
{
    // Room background
    if (lightOn)
        rectangle(x, y, w, h, 0.95f, 0.91f, 0.70f);
    else
        rectangle(x, y, w, h, 0.25f, 0.29f, 0.38f);

    // Room floor
    rectangle(x, y, w, 18, 0.55f, 0.40f, 0.30f);

    // Room borders
    color(0.12f, 0.16f, 0.22f);

    glLineWidth(4);

    glBegin(GL_LINE_LOOP);

    glVertex2f(x, y);
    glVertex2f(x + w, y);
    glVertex2f(x + w, y + h);
    glVertex2f(x, y + h);

    glEnd();

    // Room title
    text(x + 12, y + h - 25, name,
         0.12f, 0.15f, 0.20f);

    // Ceiling lamp
    circle(x + w / 2, y + h - 55, 12,
           lightOn ? 1.0f : 0.35f,
           lightOn ? 0.90f : 0.35f,
           lightOn ? 0.30f : 0.35f);

    if (lightOn)
    {
        // Light rays
        line(x + w / 2 - 18, y + h - 75,
             x + w / 2 - 35, y + h - 105,
             1, 0.85f, 0.30f);

        line(x + w / 2 + 18, y + h - 75,
             x + w / 2 + 35, y + h - 105,
             1, 0.85f, 0.30f);
    }
}

// ==========================================
// FURNITURE
// ==========================================

void drawSofa(float x, float y)
{
    rectangle(x, y, 115, 35, 0.20f, 0.42f, 0.65f);
    rectangle(x - 8, y + 25, 130, 20, 0.15f, 0.32f, 0.55f);

    rectangle(x + 8, y + 8, 35, 22, 0.30f, 0.55f, 0.78f);
    rectangle(x + 70, y + 8, 35, 22, 0.30f, 0.55f, 0.78f);
}

void drawBed(float x, float y)
{
    rectangle(x, y, 115, 55, 0.75f, 0.78f, 0.88f);
    rectangle(x, y + 45, 115, 18, 0.40f, 0.30f, 0.25f);

    rectangle(x + 8, y + 30, 42, 15, 0.95f, 0.95f, 0.95f);
}

void drawTable(float x, float y)
{
    rectangle(x, y, 80, 10, 0.40f, 0.22f, 0.12f);

    rectangle(x + 7, y - 35, 8, 35, 0.35f, 0.20f, 0.10f);
    rectangle(x + 65, y - 35, 8, 35, 0.35f, 0.20f, 0.10f);
}

// ==========================================
// FAN DRAWING AND ANIMATION
// ==========================================

void drawFan(float x, float y, float angle)
{
    // Fan body
    circle(x, y, 8, 0.25f, 0.28f, 0.32f);

    glPushMatrix();

    glTranslatef(x, y, 0);

    glRotatef(angle, 0, 0, 1);

    // Three blades
    for (int i = 0; i < 3; i++)
    {
        glPushMatrix();

        glRotatef(i * 120.0f, 0, 0, 1);

        rectangle(-5, 8, 10, 42,
                 0.25f, 0.55f, 0.75f);

        glPopMatrix();
    }

    glPopMatrix();
}

// ==========================================
// DOOR
// ==========================================

void drawDoor()
{
    float x = 35;
    float y = 100;

    // Door frame
    rectangle(x - 5, y - 5, 75, 110,
              0.25f, 0.15f, 0.10f);

    // Door rotates around its left hinge
    glPushMatrix();

    glTranslatef(x, y, 0);

    glRotatef(doorAngle, 0, 0, 1);

    rectangle(0, 0, 65, 100,
              0.55f, 0.30f, 0.15f);

    circle(52, 48, 4, 1, 0.85f, 0.20f);

    glPopMatrix();

    text(x, y - 22, "MAIN DOOR",
         0.1f, 0.1f, 0.1f);
}

// ==========================================
// WINDOW
// ==========================================

void drawWindow()
{
    float x = 350;
    float y = 360;

    rectangle(x, y, 100, 65,
              0.20f, 0.30f, 0.40f);

    // Two sliding panels
    float offset = windowOffset;

    rectangle(x + offset, y + 5, 43, 55,
              0.35f, 0.75f, 0.95f);

    rectangle(x + 52 - offset, y + 5, 43, 55,
              0.35f, 0.75f, 0.95f);

    line(x + 50, y, x + 50, y + 65,
         0.10f, 0.10f, 0.10f, 3);

    text(x + 15, y - 15, "WINDOW",
         0.1f, 0.1f, 0.1f);
}

// ==========================================
// COMPLETE HOUSE
// ==========================================

void drawHouse()
{
    // Main house background
    rectangle(20, 80, 760, 540,
              0.90f, 0.92f, 0.95f);

    // Roof
    color(0.45f, 0.18f, 0.16f);

    glBegin(GL_TRIANGLES);

    glVertex2f(20, 620);
    glVertex2f(400, 700);
    glVertex2f(780, 620);

    glEnd();

    // Three rooms
    drawRoom(30, 100, 245, 500,
             "LIVING ROOM", livingLight);

    drawRoom(280, 100, 245, 500,
             "BEDROOM", bedroomLight);

    drawRoom(530, 100, 245, 500,
             "KITCHEN", kitchenLight);

    // Living room furniture
    drawSofa(75, 175);
    drawTable(165, 155);

    // Bedroom furniture
    drawBed(340, 170);

    // Kitchen furniture
    drawTable(590, 180);

    // Fans
    if (livingFan)
        drawFan(150, 510, livingFanAngle);
    else
        drawFan(150, 510, 0);

    if (bedroomFan)
        drawFan(400, 510, bedroomFanAngle);
    else
        drawFan(400, 510, 0);

    // Door and window
    drawDoor();
    drawWindow();

    // Main title
    text(30, 675, "SMART HOME",
         1, 1, 1);
}

// ==========================================
// DASHBOARD
// ==========================================

void drawDashboard()
{
    rectangle(800, 20, 380, 710,
              0.12f, 0.16f, 0.23f);

    text(825, 695, "SMART HOME DASHBOARD",
         0.30f, 0.85f, 1.0f);

    line(820, 675, 1155, 675,
         0.40f, 0.50f, 0.60f);

    // Lighting status
    text(825, 645, "LIGHTING CONTROL",
         1, 0.85f, 0.35f);

    text(830, 620, "Living Room:");
    text(1010, 620,
         livingLight ? "ON" : "OFF",
         livingLight ? 0.2f : 1.0f,
         livingLight ? 1.0f : 0.3f,
         0.3f);

    text(830, 595, "Bedroom:");
    text(1010, 595,
         bedroomLight ? "ON" : "OFF");

    text(830, 570, "Kitchen:");
    text(1010, 570,
         kitchenLight ? "ON" : "OFF");

    // Fan status
    line(820, 550, 1155, 550, 0.4f, 0.5f, 0.6f);

    text(825, 525, "FAN CONTROL",
         1, 0.85f, 0.35f);

    text(830, 500, "Living Fan:");
    text(1010, 500, livingFan ? "ON" : "OFF");

    text(830, 475, "Bedroom Fan:");
    text(1010, 475, bedroomFan ? "ON" : "OFF");

    text(830, 450, "Fan Speed:");
    text(1010, 450, to_string(fanSpeed));

    // Door and window
    line(820, 430, 1155, 430, 0.4f, 0.5f, 0.6f);

    text(825, 405, "DOOR & WINDOW",
         1, 0.85f, 0.35f);

    text(830, 380, "Main Door:");
    text(1010, 380, doorOpen ? "OPEN" : "CLOSED");

    text(830, 355, "Window:");
    text(1010, 355, windowOpen ? "OPEN" : "CLOSED");

    // Security
    line(820, 335, 1155, 335, 0.4f, 0.5f, 0.6f);

    text(825, 310, "SECURITY SYSTEM",
         1, 0.85f, 0.35f);

    text(830, 285, "Security:");
    text(1010, 285,
         securityEnabled ? "ARMED" : "DISABLED",
         securityEnabled ? 0.2f : 1.0f,
         securityEnabled ? 1.0f : 0.3f,
         0.3f);

    text(830, 260, "Alarm:");
    text(1010, 260,
         alarmActive ? "ACTIVE!" : "NORMAL",
         alarmActive ? 1 : 0.2f,
         alarmActive ? 0.2f : 1,
         0.2f);

    // Temperature
    line(820, 240, 1155, 240, 0.4f, 0.5f, 0.6f);

    text(825, 215, "TEMPERATURE",
         1, 0.85f, 0.35f);

    stringstream tempText;
    tempText << fixed << setprecision(1)
             << temperature << " C";

    text(830, 190, "Current:");
    text(1010, 190, tempText.str());

    // Energy
    line(820, 170, 1155, 170, 0.4f, 0.5f, 0.6f);

    text(825, 145, "ENERGY MONITOR",
         1, 0.85f, 0.35f);

    stringstream powerText;
    powerText << totalPower << " W";

    text(830, 120, "Total Power:");
    text(1010, 120, powerText.str());

    stringstream energyText;
    energyText << fixed << setprecision(4)
               << energyConsumption << " kWh";

    text(830, 95, "Energy:");
    text(1010, 95, energyText.str());

    // Keyboard hint
    text(825, 60, "Press H for keyboard help",
         0.7f, 0.8f, 0.9f);
}

// ==========================================
// POWER CALCULATION
// ==========================================

void calculatePower()
{
    totalPower = 0;

    if (livingLight) totalPower += 20;
    if (bedroomLight) totalPower += 15;
    if (kitchenLight) totalPower += 15;

    if (livingFan) totalPower += 60 * fanSpeed;
    if (bedroomFan) totalPower += 60 * fanSpeed;
}

// ==========================================
// KEYBOARD HELP
// ==========================================

void drawHelp()
{
    rectangle(100, 130, 650, 480,
              0.12f, 0.16f, 0.23f);

    text(130, 570, "KEYBOARD CONTROLS",
         0.3f, 0.85f, 1);

    text(130, 525, "1 - Living Room Light");
    text(130, 495, "2 - Bedroom Light");
    text(130, 465, "3 - Kitchen Light");

    text(130, 425, "F - Living Fan ON/OFF");
    text(130, 395, "B - Bedroom Fan ON/OFF");
    text(130, 365, "+ / - - Fan Speed");

    text(130, 325, "D - Main Door");
    text(130, 295, "W - Window");

    text(130, 255, "S - Security ON/OFF");
    text(130, 225, "A - Reset Alarm");

    text(430, 525, "T - Increase Temperature");
    text(430, 495, "Y - Decrease Temperature");
    text(430, 465, "R - Reset System");

    text(430, 425, "H - Hide Help");
    text(430, 395, "ESC - Exit");

    text(430, 325, "Press any key to return",
         0.3f, 0.85f, 1);
}

bool showHelp = false;

// ==========================================
// DISPLAY FUNCTION
// ==========================================

void display()
{
    glClear(GL_COLOR_BUFFER_BIT);

    glLoadIdentity();

    drawHouse();
    drawDashboard();

    if (showHelp)
        drawHelp();

    glutSwapBuffers();
}

// ==========================================
// KEYBOARD FUNCTION
// ==========================================

void keyboard(unsigned char key, int x, int y)
{
    switch (key)
    {
        case '1':
            livingLight = !livingLight;
            break;

        case '2':
            bedroomLight = !bedroomLight;
            break;

        case '3':
            kitchenLight = !kitchenLight;
            break;

        case 'f':
        case 'F':
            livingFan = !livingFan;
            break;

        case 'b':
        case 'B':
            bedroomFan = !bedroomFan;
            break;

        case '+':
        case '=':
            if (fanSpeed < 3)
                fanSpeed++;
            break;

        case '-':
        case '_':
            if (fanSpeed > 1)
                fanSpeed--;
            break;

        case 'd':
        case 'D':
            doorOpen = !doorOpen;
            break;

        case 'w':
        case 'W':
            windowOpen = !windowOpen;
            break;

        case 's':
        case 'S':
            securityEnabled = !securityEnabled;

            if (!securityEnabled)
                alarmActive = false;

            break;

        case 'a':
        case 'A':
            alarmActive = false;
            break;

        case 't':
        case 'T':
            if (temperature < 45)
                temperature += 1;
            break;

        case 'y':
        case 'Y':
            if (temperature > 10)
                temperature -= 1;
            break;

        case 'h':
        case 'H':
            showHelp = !showHelp;
            break;

        case 'r':
        case 'R':
            livingLight = false;
            bedroomLight = false;
            kitchenLight = false;

            livingFan = false;
            bedroomFan = false;

            fanSpeed = 1;

            doorOpen = false;
            windowOpen = false;

            securityEnabled = false;
            alarmActive = false;

            temperature = 28.0f;

            energyConsumption = 0;
            simulationSeconds = 0;

            break;

        case 27:
            exit(0);
            break;
    }

    // Security alarm logic
    if (securityEnabled && doorOpen)
        alarmActive = true;

    glutPostRedisplay();
}

// ==========================================
// ANIMATION TIMER
// ==========================================

void update(int value)
{
    // Fan rotation
    if (livingFan)
        livingFanAngle += 2.0f * fanSpeed;

    if (bedroomFan)
        bedroomFanAngle += 2.0f * fanSpeed;

    if (livingFanAngle >= 360)
        livingFanAngle -= 360;

    if (bedroomFanAngle >= 360)
        bedroomFanAngle -= 360;

    // Door animation
    float targetDoor = doorOpen ? 75.0f : 0.0f;

    if (doorAngle < targetDoor)
        doorAngle += 3.0f;

    if (doorAngle > targetDoor)
        doorAngle -= 3.0f;

    // Window animation
    float targetWindow = windowOpen ? 25.0f : 0.0f;

    if (windowOffset < targetWindow)
        windowOffset += 1.0f;

    if (windowOffset > targetWindow)
        windowOffset -= 1.0f;

    // Temperature simulation
    if (livingFan || bedroomFan)
    {
        if (temperature > 24)
            temperature -= 0.002f;
    }

    // Energy monitoring
    calculatePower();

    // One timer unit = 1 simulated second
    static int energyTick = 0;

    energyTick++;

    if (energyTick >= 63)
    {
        energyConsumption += totalPower / 3600000.0f;
        simulationSeconds++;
        energyTick = 0;
    }

    // Keep fan speed animation smooth
    glutPostRedisplay();

    glutTimerFunc(16, update, 0);
}

// ==========================================
// OPENGL INITIALIZATION
// ==========================================

void init()
{
    glClearColor(0.90f, 0.93f, 0.97f, 1.0f);

    glMatrixMode(GL_PROJECTION);

    glLoadIdentity();

    gluOrtho2D(0, WIDTH, 0, HEIGHT);

    glMatrixMode(GL_MODELVIEW);
}

// ==========================================
// MAIN FUNCTION
// ==========================================

int main(int argc, char** argv)
{
    glutInit(&argc, argv);

    glutInitDisplayMode(
        GLUT_DOUBLE | GLUT_RGB
    );

    glutInitWindowSize(WIDTH, HEIGHT);

    glutInitWindowPosition(100, 50);

    glutCreateWindow(
        "Smart Home Automation System - CGM Project"
    );

    init();

    glutDisplayFunc(display);

    glutKeyboardFunc(keyboard);

    glutTimerFunc(16, update, 0);

    glutMainLoop();

    return 0;
}
